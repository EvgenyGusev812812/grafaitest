      ]
    },
    "panels": [
      { "id": 100, "type": "row", "title": "[M1] [JAVA]", "collapsed": false, "panels": [], "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
      {
        "id": 101, "gridPos": { "h": 5, "w": 24, "x": 0, "y": 1 },
        "title": "Java micrometer", "type": "text",
        "options": {
          "mode": "markdown",
          "content": "Для отображения метрик необходимо в сервисе подключить библиотеки\n```groovy\n    implementation \"io.micrometer:micrometer-core\"\n    implementation \"io.micrometer:micrometer-registry-prometheus\"\n```\n",
          "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false }
        }
      },
      {
        "id": 102, "gridPos": { "h": 7, "w": 8, "x": 0, "y": 6 },
        "title": "[M1] [JAVA] [REST-IN] RPS by Method", "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "bfuyrw76u31fkc" },
        "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1 } }, "overrides": [] },
        "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
        "targets": [
          {
            "refId": "A", "editorMode": "code", "range": true,
            "expr": "sum (rate(http_server_requests_seconds_count{app=\"$service\", uri!~\"^/(manage|actuator).*\"})) by (uri)",
            "legendFormat": "{{uri}}",
            "datasource": { "type": "prometheus", "uid": "bfuyrw76u31fkc" }
          }
        ]
      },
      {
        "id": 103, "gridPos": { "h": 7, "w": 8, "x": 8, "y": 6 },
        "title": "[M1] [JAVA] [REST-IN] Max Response Time by Method", "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "bfuyrw76u31fkc" },
        "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1 } }, "overrides": [] },
        "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
        "targets": [
          {
            "refId": "A", "editorMode": "code", "range": true,
            "expr": "max(http_server_requests_seconds_max{app=\"$service\", uri!~\"^/(manage|actuator).*\"} * 1000) by (uri)",
            "legendFormat": "__auto",
            "datasource": { "type": "prometheus", "uid": "bfuyrw76u31fkc" }
          }
        ]
      },
      {
        "id": 104, "gridPos": { "h": 7, "w": 8, "x": 16, "y": 6 },
        "title": "[M1] [JAVA] [REST-IN] RPS by HTTP Code", "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "bfuyrw76u31fkc" },
        "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1 } }, "overrides": [] },
        "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
        "targets": [
          {
            "refId": "A", "editorMode": "code", "range": true,
            "expr": "sum(rate(http_server_requests_seconds_count{app=\"$service\", uri!~\"^/(manage|actuator).*\"}[1m])) by (status)",
            "legendFormat": "__auto",
            "datasource": { "type": "prometheus", "uid": "bfuyrw76u31fkc" }
          }
        ]
      },
      { "id": 110, "type": "row", "title": "[M1] [OTEL]", "collapsed": false, "panels": [], "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 } },
      {
        "id": 111, "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
        "title": "[M1] [OTEL] [REST-IN] RPS by Method", "type": "timeseries",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-otel-placeholder" },
        "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1 } }, "overrides": [] },
        "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
        "targets": [
          {
            "refId": "A", "editorType": "sql", "format": 0, "queryType": "timeseries",
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-otel-placeholder" },
            "rawSql": "SELECT\n  toStartOfInterval(Timestamp, toIntervalSecond(${__interval_ms} / 1000)) AS time,\n  SpanAttributes['http.route'] as route,\n  count() / (${__interval_ms} / 1000) AS rps\nFROM otel.otel_traces\nWHERE\n  $__timeFilter(Timestamp)\n  AND ServiceName in ('${service}', 'bm-${service}')\n  AND SpanAttributes['http.route'] is not null\n  AND SpanAttributes['http.route'] != ''\nGROUP BY time, route\nORDER BY time"
          }
        ]
      },
      {
        "id": 112, "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
        "title": "[M1] [OTEL] [REST-IN] RPS by HTTP Code", "type": "timeseries",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-otel-placeholder" },
        "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1 } }, "overrides": [] },
        "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
        "targets": [
          {
            "refId": "A", "editorType": "sql", "format": 0, "queryType": "timeseries",
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-otel-placeholder" },
            "rawSql": "SELECT\n  toStartOfInterval(Timestamp, toIntervalSecond(${__interval_ms} / 1000)) AS time,\n  count() / (${__interval_ms} / 1000) AS code,\n  SpanAttributes['http.status_code'] as status_code\nFROM otel.otel_traces\nWHERE\n  $__timeFilter(Timestamp)\n  AND ServiceName in ('${service}', 'bm-${service}')\n  AND SpanAttributes['http.route'] is not null\n  AND SpanAttributes['http.route'] != ''\n  AND SpanAttributes['http.status_code'] is not null\n  AND SpanAttributes['http.status_code'] != ''\nGROUP BY time, status_code\nORDER BY time"
          }
        ]
      },
      {
        "id": 113, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
        "title": "[M1] [OTEL] [REST-IN] P99 Latency by Method", "type": "timeseries",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-otel-placeholder" },
        "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1 } }, "overrides": [] },
        "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
        "targets": [
          {
            "refId": "A", "editorType": "sql", "format": 0, "queryType": "timeseries",
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-otel-placeholder" },
            "rawSql": "SELECT\n  toStartOfInterval(Timestamp, toIntervalSecond(${__interval_ms} / 1000)) AS time,\n  SpanAttributes['http.route'] as route,\n  quantile(0.99)(Duration / 1000000) AS p99\nFROM otel.otel_traces\nWHERE\n  $__timeFilter(Timestamp)\n  AND ServiceName in ('${service}', 'bm-${service}')\n  AND SpanAttributes['http.route'] is not null\n  AND SpanAttributes['http.route'] != ''\nGROUP BY time, route\nORDER BY time"
          }
        ]
      },
      {
        "id": 114, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
        "title": "[M1] [OTEL] [REST-IN] P95 Latency by Method", "type": "timeseries",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-otel-placeholder" },
        "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1 } }, "overrides": [] },
        "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
        "targets": [
          {
            "refId": "A", "editorType": "sql", "format": 0, "queryType": "timeseries",
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-otel-placeholder" },
            "rawSql": "SELECT\n  toStartOfInterval(Timestamp, toIntervalSecond(${__interval_ms} / 1000)) AS time,\n  SpanAttributes['http.route'] as route,\n  quantile(0.95)(Duration / 1000000) AS p95\nFROM otel.otel_traces\nWHERE\n  $__timeFilter(Timestamp)\n  AND ServiceName in ('${service}', 'bm-${service}')\n  AND SpanAttributes['http.route'] is not null\n  AND SpanAttributes['http.route'] != ''\nGROUP BY time, route\nORDER BY time"
          }
        ]
      },
      { "id": 120, "type": "row", "title": "[M1] [ISTIO]", "collapsed": false, "panels": [], "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 } },
      {
        "id": 121, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
        "title": "[M1] [ISTIO] [REST-IN] RPS by HTTP Code", "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "bfuyrw76u31fkc" },
        "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1 } }, "overrides": [] },
        "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
        "targets": [
          {
            "refId": "A", "editorMode": "code", "range": true,
            "expr": "sum(rate(istio_requests_total{destination_service_name=~\"(bm-)?${service}(-green|-blue)?$\", request_protocol=\"http\", destination_workload!=\"unknown\"}[1m])) by (response_code)",
            "legendFormat": "{{response_code}}",
            "datasource": { "type": "prometheus", "uid": "bfuyrw76u31fkc" }
          }
        ]
      },
      {
        "id": 122, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
        "title": "[M1] [ISTIO] [REST-IN] P50, P95, P99 Latency", "type": "timeseries",
        "datasource": { "type": "prometheus", "uid": "bfuyrw76u31fkc" },
        "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 1 } }, "overrides": [] },
        "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
        "targets": [
          { "refId": "A", "editorMode": "code", "range": true, "legendFormat": "p50",
            "expr": "histogram_quantile(0.50, \n  sum(rate(istio_request_duration_seconds_bucket{destination_service_name=~\"(bm-)?${service}(-green|-blue)?$\", request_protocol=\"http\", destination_workload!=\"unknown\"}[1m])) by (le)\n) * 1000",
            "datasource": { "type": "prometheus", "uid": "bfuyrw76u31fkc" } },
          { "refId": "B", "editorMode": "code", "range": true, "legendFormat": "p95",
            "expr": "histogram_quantile(0.95, \n  sum(rate(istio_request_duration_seconds_bucket{destination_service_name=~\"(bm-)?${service}(-green|-blue)?$\", request_protocol=\"http\", destination_workload!=\"unknown\"}[1m])) by (le)\n) * 1000",
            "datasource": { "type": "prometheus", "uid": "bfuyrw76u31fkc" } },
          { "refId": "C", "editorMode": "code", "range": true, "legendFormat": "p99",
            "expr": "histogram_quantile(0.99, \n  sum(rate(istio_request_duration_seconds_bucket{destination_service_name=~\"(bm-)?${service}(-green|-blue)?$\", request_protocol=\"http\", destination_workload!=\"unknown\"}[1m])) by (le)\n) * 1000",
            "datasource": { "type": "prometheus", "uid": "bfuyrw76u31fkc" } }
        ]
      }
    ]
  }
}
