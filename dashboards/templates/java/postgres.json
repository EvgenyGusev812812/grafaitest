            "pluginVersion": "4.11.1",
            "queryType": "timeseries",
            "rawSql": "SELECT\n  toStartOfInterval(Timestamp, toIntervalSecond(${__interval_ms} / 1000)) AS time,\n  'db: ' || SpanAttributes['db.name'] || ' ' || SpanAttributes['db.operation'] as statement,\n  quantile(0.99)(Duration / 1000000) AS p99\nFROM otel.otel_traces\nWHERE\n  $__timeFilter(Timestamp)\n  AND ServiceName in ('${service}', 'bm-${service}')\n  AND SpanAttributes['db.system'] = 'postgresql'\n  AND SpanAttributes['db.operation'] != ''\nGROUP BY time, statement\nORDER BY time",
