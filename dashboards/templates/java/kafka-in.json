            "pluginVersion": "4.11.1",
            "queryType": "timeseries",
            "rawSql": "SELECT\n  toStartOfInterval(Timestamp, toIntervalSecond(${__interval_ms} / 1000)) AS time,\n  SpanAttributes['messaging.destination.name'] as topic,\n  count() / (${__interval_ms} / 1000) AS rps\nFROM otel.otel_traces\nWHERE\n  $__timeFilter(Timestamp)\n  AND ServiceName in ('${service}', 'bm-${service}')\n  AND SpanAttributes['messaging.system'] = 'kafka'\n  AND SpanAttributes['messaging.system'] != ''\n  AND SpanAttributes['messaging.operation'] = 'process'\nGROUP BY time, topic\nORDER BY time",
